{
  "name": "agent-techport-sources",
  "version": "0.1.3",
  "description": "Agent TechPort Sources: local MCP servers that call public government data sources directly (NASA TechPort, NTRS and Technology Transfer; SBIR; USAspending; SEC EDGAR). No third-party servers, no telemetry.",
  "author": {
    "name": "Claude Opus 5.5 and Alexander van Dijk"
  },
  "license": "Apache-2.0",
  "keywords": [
    "nasa",
    "sbir",
    "techport",
    "ntrs",
    "usaspending",
    "technology transfer",
    "edgar",
    "research"
  ],
  "userConfig": {
    "sec_name": {
      "type": "string",
      "title": "Your name, for SEC EDGAR",
      "description": "SEC asks every program that reads EDGAR to send a name and an email address. Both are sent only to SEC. Leave empty if you won't use the EDGAR tools.",
      "required": false
    },
    "sec_email": {
      "type": "string",
      "title": "Your email address, for SEC EDGAR",
      "description": "Needed for the EDGAR tools; sent only to SEC. Leave empty if you won't use them.",
      "required": false
    }
  },
  "mcpServers": {
    "sbir": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--frozen",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "servers.sbir"
      ]
    },
    "techport": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--frozen",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "servers.techport"
      ]
    },
    "usaspending": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--frozen",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "servers.usaspending"
      ]
    },
    "ntrs": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--frozen",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "servers.ntrs"
      ]
    },
    "techtransfer": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--frozen",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "servers.techtransfer"
      ]
    },
    "edgar": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--frozen",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "servers.edgar"
      ],
      "env": {
        "SEC_NAME": "${user_config.sec_name}",
        "SEC_EMAIL": "${user_config.sec_email}"
      }
    }
  }
}
